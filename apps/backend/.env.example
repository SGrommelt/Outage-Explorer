# Local EIA exploration/extraction only. Never commit the real key.
EIA_API_KEY=

# DEVELOPMENT ONLY: run python -m outage_explorer.seed_auth to configure
# viewer, analyst, and admin, choosing their passwords interactively.
# No default passwords or signing keys are provided.
AUTH_SIGNING_KEY=
AUTH_TOKEN_SECONDS=600
# Single-quoted JSON list of exactly three users, one per role. Each record:
# {"username":"viewer","role":"viewer","password_hash":"<PBKDF2 hash>"}
# seed_auth fills this with hashes, never plaintext passwords.
AUTH_USERS_JSON=
